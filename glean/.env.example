# Glean local environment
# Copy to .env and adjust as needed for your machine.

# Runtime mode
NODE_ENV=development
GLEAN_ENV=local

# Frontend <-> Backend wiring
NEXT_PUBLIC_API_BASE_URL=http://localhost:8088
NEXT_PUBLIC_GRAPH_WS_URL=ws://localhost:8088/ws

# Backend listener
GLEAN_BACKEND_HOST=0.0.0.0
GLEAN_BACKEND_PORT=8088

# Frontend dev server
GLEAN_FRONTEND_HOST=0.0.0.0
GLEAN_FRONTEND_PORT=3000

# Local graph/state database (PostgreSQL-based graph model)
GLEAN_DATABASE_HOST=127.0.0.1
GLEAN_DATABASE_PORT=5432
GLEAN_DATABASE_NAME=glean
GLEAN_DATABASE_USER=glean
GLEAN_DATABASE_PASSWORD=glean_dev_password
GLEAN_DATABASE_URL=postgresql://glean:glean_dev_password@127.0.0.1:5432/glean?sslmode=disable

# Optional cache/queue endpoint if needed by worker runtime
GLEAN_QUEUE_URL=redis://127.0.0.1:6379/0

# Security and routing defaults
GLEAN_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-local-dev-key
GLEAN_ROUTING_MODE=direct
